    background:linear-gradient(135deg,var(--royal),var(--teal));
    display:flex;align-items:center;justify-content:center;color:#fff;margin-bottom:16px;
  }
  .why-icon svg{width:22px;height:22px;}
  .why-card h3{font-size:1.08rem;margin-bottom:8px;}
  .why-card p{color:var(--text-soft);font-size:0.94rem;margin:0;}

  /* ===== SERVICES (Maths / Science) ===== */
  .service-row{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;}
  @media (max-width:880px){ .service-row{grid-template-columns:1fr;} }
  .service-block{background:var(--card);border:1px solid var(--line);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);}
