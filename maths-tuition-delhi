  }
  .concern-mark{
    font-family:'Fraunces',serif;color:var(--amber);font-size:1.3rem;flex:none;line-height:1;
  }
  .concern-item p{margin:0;color:var(--text-soft);font-size:0.94rem;}
  .concern-item strong{color:var(--navy);display:block;margin-bottom:3px;font-size:0.98rem;}

  /* ===== FAQ ===== */
  .faq-item{border-bottom:1px solid var(--line);}
  .faq-q{
    width:100%;text-align:left;background:none;border:none;cursor:pointer;
    padding:20px 4px;display:flex;justify-content:space-between;align-items:center;gap:16px;
    font-family:'Fraunces',serif;font-size:1.05rem;color:var(--navy);font-weight:600;
  }
  .faq-q svg{flex:none;width:20px;height:20px;color:var(--royal);transition:transform .2s;}
  .faq-item[open] .faq-q svg{transform:rotate(45deg);}
  .faq-a{padding:0 4px 20px;color:var(--text-soft);font-size:0.96rem;max-width:70ch;}
  details.faq-item{padding:0;}
  details > summary{list-style:none;}
  details > summary::-webkit-details-marker{display:none;}

  /* ===== FINAL CTA ===== */
  .final-cta{
    background:linear-gradient(135deg,var(--navy),var(--royal));
    border-radius:28px;padding:56px 40px;text-align:center;color:#fff;
    position:relative;overflow:hidden;
  }
  .final-cta::after{
    content:"";position:absolute;width:340px;height:340px;border-radius:50%;
    background:radial-gradient(circle,rgba(242,169,59,0.35),transparent 70%);
    top:-140px;right:-100px;
  }
  .final-cta h2{color:#fff;font-size:clamp(1.6rem,3.2vw,2.1rem);position:relative;}
  .final-cta p{color:#D8E1F6;max-width:56ch;margin:14px auto 28px;position:relative;}
  .final-cta .hero-ctas{justify-content:center;position:relative;}

  /* ===== FOOTER ===== */
  footer{background:var(--navy);color:#B9C6E8;padding:48px 0 28px;font-size:0.9rem;}
  .footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:32px;margin-bottom:28px;}
  @media (max-width:760px){ .footer-grid{grid-template-columns:1fr;} }
  footer h4{color:#fff;font-size:0.85rem;letter-spacing:0.04em;text-transform:uppercase;margin-bottom:14px;font-family:'IBM Plex Mono',monospace;}
  footer ul{list-style:none;padding:0;margin:0;display:grid;gap:9px;}
  footer a{text-decoration:none;color:#B9C6E8;}
  footer a:hover{color:#fff;}
  .footer-bottom{border-top:1px solid rgba(255,255,255,0.12);padding-top:20px;font-size:0.82rem;color:#8FA0C9;display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;}

  .sticky-wa{
    position:fixed;bottom:20px;right:20px;z-index:60;
    width:58px;height:58px;border-radius:50%;background:#25D366;color:var(--navy);
    display:flex;align-items:center;justify-content:center;box-shadow:0 10px 24px -8px rgba(0,0,0,0.4);
    text-decoration:none;
  }
  .sticky-wa svg{width:28px;height:28px;}
  @media (max-width:600px){ .sticky-wa{width:52px;height:52px;bottom:16px;right:16px;} }
</style>
