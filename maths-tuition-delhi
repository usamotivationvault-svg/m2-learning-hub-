  .card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  @media (max-width:880px){ .card-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:560px){ .card-grid{grid-template-columns:1fr;} }
