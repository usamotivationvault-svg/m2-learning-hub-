  .trust-row li{list-style:none;display:flex;align-items:center;gap:8px;}
  .trust-row{list-style:none;padding:0;margin:0;}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--teal);flex:none;}

  /* Signature visual: worked-solution / graph paper card */
  .hero-visual{position:relative;}
  .solution-card{
    background:var(--card);
    border-radius:var(--radius-lg);
    box-shadow:var(--shadow);
    padding:28px 26px 24px;
    background-image:
