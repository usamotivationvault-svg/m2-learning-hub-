    color:#fff;font-weight:700;padding:10px 20px;border-radius:100px;font-size:0.92rem;
  }

  /* ===== FORMATS ===== */
  .format-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  @media (max-width:880px){ .format-grid{grid-template-columns:1fr;} }
  .format-card{
    background:var(--card);border-radius:var(--radius-lg);padding:30px 26px;
    border:1px solid var(--line);position:relative;box-shadow:var(--shadow-sm);
  }
  .format-card.featured{border:2px solid var(--amber);}
  .featured-badge{
    position:absolute;top:-13px;left:26px;background:var(--amber);color:#fff;
    font-family:'IBM Plex Mono',monospace;font-size:0.68rem;font-weight:600;
    padding:5px 12px;border-radius:100px;letter-spacing:0.04em;
  }
  .format-ratio{font-family:'Fraunces',serif;font-size:2.1rem;color:var(--royal);margin-bottom:6px;}
  .format-card h3{font-size:1.12rem;margin-bottom:10px;}
  .format-card p{color:var(--text-soft);font-size:0.93rem;}

  /* ===== FACULTY ===== */
  .faculty-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:26px;}
  @media (max-width:760px){ .faculty-grid{grid-template-columns:1fr;} }
